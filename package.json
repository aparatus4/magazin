{
  "name": "forma",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.22.1",
    "pnpm": ">=11.25.0 <12"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "dev:legacy": "pnpm --dir legacy dev",
    "build:legacy": "pnpm --dir legacy build",
    "test:legacy": "node scripts/functional-test.mjs",
    "contracts:build": "pnpm --filter @forma/contracts build",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
