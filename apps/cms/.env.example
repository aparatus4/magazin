# Copy to .env for local development. Never commit populated values.
# Neon Postgres connection string for the Payload database.
DATABASE_URL=postgres://replace_user:replace_password@localhost:5432/forma_cms

# Generate a long random value. Never commit it.
PAYLOAD_SECRET=replace_with_random_payload_secret

# Public CMS origin.
NEXT_PUBLIC_CMS_URL=http://localhost:3001
