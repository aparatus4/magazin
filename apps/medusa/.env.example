# Copy to .env for local development. Never commit a populated .env.
# Deployment validation must reject these placeholders.

NODE_ENV=development

# PostgreSQL (Neon in deployed environments)
DATABASE_URL=postgres://replace_user:replace_password@localhost:5432/forma

# Redis (workflow engine and queues)
REDIS_URL=redis://localhost:6379

# Generate independent random values of at least 32 bytes.
JWT_SECRET=replace_with_random_jwt_secret
COOKIE_SECRET=replace_with_random_cookie_secret

# Exact origins only. No wildcards, no null.
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:9000

# Medusa Admin is served at /app by default. Set ADMIN_BACKEND_URL only when
# the Admin SPA is hosted separately from the API.
ADMIN_PATH=/app
# ADMIN_BACKEND_URL=https://api.forma.example
# Set true in production when the standalone Admin build is served from its own
# static host; leave false for local development at /app.
ADMIN_DISABLED=false

# Public origin used to build catalogue image URLs during seeding.
# Defaults to the local storefront when unset.
# PUBLIC_ASSET_BASE_URL=http://localhost:3000

# Stripe test credentials for local development. Replace both placeholders
# with values from the Stripe test dashboard before running verify:payments.
STRIPE_API_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Public catalogue assets (R2). This provider must never serve customer uploads.
R2_PUBLIC_ENDPOINT=https://replace_me.r2.cloudflarestorage.com
R2_PUBLIC_BUCKET=forma-public
R2_PUBLIC_ACCESS_KEY_ID=replace_me
R2_PUBLIC_SECRET_ACCESS_KEY=replace_me
R2_PUBLIC_URL=https://assets.replace_me.example

# Private customer uploads (R2). Separate credentials and buckets from public assets.
R2_PRIVATE_ENDPOINT=https://replace_me.r2.cloudflarestorage.com
R2_PRIVATE_REGION=auto
R2_UPLOAD_STAGING_BUCKET=forma-upload-staging
R2_UPLOAD_STAGING_ACCESS_KEY_ID=replace_me
R2_UPLOAD_STAGING_SECRET_ACCESS_KEY=replace_me
R2_UPLOAD_QUARANTINE_BUCKET=forma-upload-quarantine
R2_UPLOAD_QUARANTINE_ACCESS_KEY_ID=replace_me
R2_UPLOAD_QUARANTINE_SECRET_ACCESS_KEY=replace_me
R2_WORKER_ACCESS_KEY_ID=replace_me
R2_WORKER_SECRET_ACCESS_KEY=replace_me
R2_DOWNLOAD_SIGNER_ACCESS_KEY_ID=replace_me
R2_DOWNLOAD_SIGNER_SECRET_ACCESS_KEY=replace_me

# Upload intent signing (Medusa-only secret).
UPLOAD_INTENT_SECRET=replace_with_random_upload_intent_secret

# Transactional email.
RESEND_API_KEY=re_replace_me
RESEND_FROM=FORMA <hello@replace_me.example>
