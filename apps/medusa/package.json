{
  "name": "@forma/medusa",
  "version": "0.1.0",
  "private": true,
  "description": "FORMA Medusa v2 backend",
  "license": "UNLICENSED",
  "scripts": {
    "build": "medusa build",
    "admin:build": "medusa build --admin-only",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "verify:catalog": "medusa exec ./src/scripts/verify-catalog.ts",
    "verify:payments": "medusa exec ./src/scripts/verify-payment-provider.ts",
    "verify:payment-truth": "medusa exec ./src/scripts/verify-payment-truth.ts",
    "start": "medusa start",
    "dev": "medusa develop",
    "typecheck": "tsc --noEmit",
    "test:integration:http": "cross-env TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "cross-env TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "cross-env TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit"
  },
  "dependencies": {
    "@forma/contracts": "workspace:*",
    "@medusajs/admin-sdk": "2.22.1",
    "@medusajs/admin-shared": "2.22.1",
    "@medusajs/cli": "2.22.1",
    "@medusajs/dashboard": "2.22.1",
    "@medusajs/draft-order": "2.22.1",
    "@medusajs/framework": "2.22.1",
    "@medusajs/medusa": "2.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.22.1",
    "@swc/core": "1.13.5",
    "@swc/jest": "0.2.39",
    "@types/jest": "29.5.14",
    "@types/node": "24.10.1",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "cross-env": "10.1.0",
    "jest": "29.7.0",
    "prop-types": "15.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "yalc": "1.0.0-pre.53"
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "packageManager": "pnpm@11.25.0"
}
