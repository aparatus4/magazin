# Copy to .env.local for local development. Never commit populated values.

# Server-only Medusa connection. Do not expose the secret key.
MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_PUBLISHABLE_KEY=pk_replace_me

# Browser-safe Medusa connection. Publishable key only.
NEXT_PUBLIC_MEDUSA_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_replace_me

# Public site origin used for canonical URLs and hreflang.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Indicative EUR display only. RON remains authoritative everywhere.
EUR_TO_RON_DISPLAY_RATE=replace_me
EUR_TO_RON_DISPLAY_RATE_DATE=1970-01-01

# Search (server-only key).
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=replace_me

# Stripe publishable key for Elements. Never place a secret key here.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
