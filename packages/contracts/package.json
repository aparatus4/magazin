{
  "name": "@forma/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Zod contracts for FORMA storefront, Medusa, CMS, and workers",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./product": {
      "types": "./dist/product.d.ts",
      "require": "./dist/product.js",
      "import": "./dist/product.js"
    },
    "./commission": {
      "types": "./dist/commission.d.ts",
      "require": "./dist/commission.js",
      "import": "./dist/commission.js"
    },
    "./quote": {
      "types": "./dist/quote.d.ts",
      "require": "./dist/quote.js",
      "import": "./dist/quote.js"
    },
    "./mesh-analysis": {
      "types": "./dist/mesh-analysis.d.ts",
      "require": "./dist/mesh-analysis.js",
      "import": "./dist/mesh-analysis.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
